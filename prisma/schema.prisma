datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssessmentStatus {
  STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

model User {
  id               String       @id @default(uuid())
  google_id        String?      @unique
  name             String
  email            String       @unique
  profile_photo    String?
  phone            String?
  date_of_birth    String?
  gender           String?
  language         String       @default("English")
  theme_preference String       @default("dark")
  role             Role         @default(USER)
  status           UserStatus   @default(ACTIVE)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  last_login       DateTime     @default(now())

  sessions         Session[]
  activities       Activity[]
  assessments      Assessment[]
  progresses       Progress[]
  memories         Memory[]
  reports          Report[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  login_time  DateTime  @default(now())
  logout_time DateTime?
  duration    Int?      // Duration in seconds
  device      String?
  browser     String?
  os          String?
  ip          String?

  @@map("sessions")
}

model Activity {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event      String
  page       String?
  metadata   Json?
  ip_address String?
  browser    String?
  device     String?
  os         String?
  created_at DateTime @default(now())

  @@map("activities")
}

model Assessment {
  id           String           @id @default(uuid())
  user_id      String
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module       String
  score        Float?
  attempt      Int              @default(1)
  started_at   DateTime         @default(now())
  completed_at DateTime?
  duration     Int?             // Duration in seconds
  status       AssessmentStatus @default(STARTED)

  answers      AssessmentAnswer[]

  @@map("assessments")
}

model AssessmentAnswer {
  id            String     @id @default(uuid())
  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  question_id   String
  question      String
  answer        String
  time_taken    Int?       // Time taken in seconds
  created_at    DateTime   @default(now())

  @@map("assessment_answers")
}

model Progress {
  id                    String   @id @default(uuid())
  user_id               String
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module                String
  completion_percentage Float    @default(0.0)
  current_question      Int      @default(1)
  status                String   @default("NOT_STARTED")
  updated_at            DateTime @updatedAt

  @@unique([user_id, module])
  @@map("progress")
}

model Memory {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  key        String
  value      String
  confidence Float    @default(1.0)
  updated_at DateTime @updatedAt

  @@unique([user_id, key])
  @@map("memory")
}

model Report {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  overall_score Float
  pdf_url       String?
  generated_at  DateTime @default(now())
  version       String   @default("1.0")

  @@map("reports")
}
